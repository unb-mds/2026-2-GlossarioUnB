{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": { "command": "node --test" },
  "mutate": [
    "frontend/js/termos.js",
    "frontend/js/validacao-termo.js",
    "frontend/js/busca.js",
    "frontend/js/lista.js",
    "frontend/js/ficha.js",
    "frontend/js/tema.js",
    "frontend/js/trilha.js",
    "coleta/*.js"
  ],
  "coverageAnalysis": "off",
  "disableTypeChecks": false,
  "concurrency": 4,
  "timeoutMS": 10000,
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "ignorePatterns": ["reports", "node_modules", ".git", "coverage"],
  "thresholds": { "high": 80, "low": 50, "break": null },
  "cleanTempDir": true
}
