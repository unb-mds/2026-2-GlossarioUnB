{
  "name": "glossario-unb",
  "private": true,
  "description": "Dicionário colaborativo de siglas, gírias e expressões da UnB (G10 — MDS 2026/2).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test",
    "test:cobertura": "node --test --experimental-test-coverage --test-coverage-include=\"frontend/js/termos.js\" --test-coverage-include=\"frontend/js/validacao-termo.js\" --test-coverage-include=\"coleta/**/*.js\" --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=90",
    "test:e2e": "playwright test --project=chromium",
    "test:aceitacao": "bddgen && playwright test --project=aceitacao",
    "test:sabotagem": "node scripts/sabotagem.mjs",
    "test:mutacao": "stryker run",
    "dev": "node --env-file-if-exists=.env scripts/servidor-local.mjs",
    "coleta": "node scripts/coletar.mjs",
    "coleta:dpo": "node scripts/coletar-dpo.mjs",
    "coleta:completa": "node --env-file-if-exists=.env scripts/coleta-automatica.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "cheerio": "^1.2.0",
    "pdfjs-dist": "5.4.296",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright-bdd": "^9.2.1"
  }
}
